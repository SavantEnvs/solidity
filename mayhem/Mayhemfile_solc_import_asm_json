project: savantenvs/solidity
target: solc_import_asm_json
cmds:
  - cmd: /mayhem/build-fuzz/solc/solc --experimental --optimize --import-asm-json @@ --bin --asm
    afl: true
    # EVM assembly JSON import (Assembly::createAssemblyItemFromJSON and friends), optimised and assembled
    # one exec is a whole compiler run under ASan+UBSan; leave room for slow hosts
    timeout: 20
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/solc_import_asm_json/testsuite
